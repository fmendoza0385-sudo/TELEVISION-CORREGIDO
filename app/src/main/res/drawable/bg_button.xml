<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/lukka_blue_dark" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/lukka_blue_light" />
            <stroke android:width="4dp" android:color="@color/lukka_white" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/lukka_blue_dark" />
            <stroke android:width="2dp" android:color="@color/lukka_white" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/lukka_blue" />
            <stroke android:width="2dp" android:color="@color/lukka_blue_light" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>

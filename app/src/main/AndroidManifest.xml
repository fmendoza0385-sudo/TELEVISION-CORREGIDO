<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Android TV (control remoto) y Smartphone (táctil) -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!-- Los canales IPTV suelen venir por http://. La licencia se valida por firma digital
         y la URL del servidor de licencias debe ser https:// (ver LicenseApi). -->
    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher_placeholder"
        android:banner="@drawable/banner_placeholder"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:hardwareAccelerated="true"
        android:theme="@style/Theme.Lukka">

        <!-- Puerta única: decide a dónde ir según el estado de la suscripción -->
        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".player.PlayerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|screenLayout|smallestScreenSize"
            android:launchMode="singleTask" />

        <activity
            android:name=".blocking.BlockingActivity"
            android:exported="false"
            android:launchMode="singleTask" />

        <activity
            android:name=".activation.ActivationActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
